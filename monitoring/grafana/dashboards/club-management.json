{
  "uid": "club-management",
  "title": "Club Management · Operations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Targets UP",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP requests / giây",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,status) (rate(club_http_requests_total[5m]))",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(club_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Node RSS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "club_process_resident_memory_bytes",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU host",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "RAM host",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "CPU containers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "RAM containers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{name!=\"\"}",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "MySQL connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Nginx requests / giây",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Dung lượng trống",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "club-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "legendFormat": "{{job}} {{name}} {{route}} {{status}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 20,
      "title": "Backend errors",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "club-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"backend\"} | json | level=\"error\""
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 9
      },
      "options": {
        "showTime": true
      }
    }
  ]
}
